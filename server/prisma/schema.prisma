generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wilayah {
  id    Int     @id @default(autoincrement())
  nama  String
  kode  String  @unique
  pasar Pasar[]
}

model Pasar {
  id        Int      @id @default(autoincrement())
  nama      String
  kecamatan String
  kelas     String
  lat       Float?
  lng       Float?
  wilayahId Int
  wilayah   Wilayah  @relation(fields: [wilayahId], references: [id])
  survei    Survei[]
}

model Komoditas {
  id           Int           @id @default(autoincrement())
  nama         String
  kategori     String
  satuan       String
  detailSurvei DetailSurvei[]
}

model Survei {
  id        Int            @id @default(autoincrement())
  tanggal   DateTime
  pasarId   Int
  pasar     Pasar          @relation(fields: [pasarId], references: [id])
  sumber    String?
  details   DetailSurvei[]
}

model DetailSurvei {
  id          Int       @id @default(autoincrement())
  surveiId    Int
  survei      Survei    @relation(fields: [surveiId], references: [id])
  komoditasId Int
  komoditas   Komoditas @relation(fields: [komoditasId], references: [id])
  harga       Float
}

model Het {
  id         Int      @id @default(autoincrement())
  kode       String   @unique
  komoditas  String
  harga      Float?
  satuan     String
  sumber     String
  status     String
  catatan    String?
  updatedAt  DateTime @updatedAt
}

model RiwayatInput {
  id          Int      @id @default(autoincrement())
  namaFile    String
  jenis       String
  jumlahBaris Int
  berhasil    Int      @default(0)
  gagal       Int      @default(0)
  status      String
  catatan     String?
  createdAt   DateTime @default(now())
}

// Catatan audit (append-only): siapa mengubah apa & kapan.
model AuditLog {
  id        Int      @id @default(autoincrement())
  admin     String
  aksi      String
  entitas   String
  entitasId Int?
  deskripsi String
  dataLama  String?
  dataBaru  String?
  ip        String?
  // Informasi perangkat & jaringan pengguna.
  userAgent String?
  os        String?
  browser   String?
  hostname  String?
  isp       String?
  berhasil  Boolean  @default(true)
  createdAt DateTime @default(now())
}
