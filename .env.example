# ============================================================
# DATABASE (backend / Prisma)
# ============================================================
# Ambil connection string dari Neon (https://neon.tech) atau
# Vercel Postgres. Gunakan versi "pooled connection" untuk runtime
# serverless. Contoh:
#   postgresql://user:pass@ep-xxx-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ============================================================
# API URL (frontend / Vite)
# ============================================================
# KOSONGKAN di Vercel: frontend otomatis pakai path relatif "/api"
# (satu domain dengan serverless function).
# Isi hanya jika backend di-deploy terpisah (mis. http://localhost:3001/api
# saat dev, atau https://backend-kamu.up.railway.app/api).
VITE_API_URL=
